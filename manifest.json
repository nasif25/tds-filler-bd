{
  "manifest_version": 3,
  "name": "TDS Certificate Filler",
  "version": "0.3.0",
  "description": "Parse an employer TDS certificate PDF locally and fill the eTax ledger Salary (Section-86) rows.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ledger.etaxnbr.gov.bd/*"
      ],
      "js": [
        "content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "lib/*",
        "vendor/*"
      ],
      "matches": [
        "https://ledger.etaxnbr.gov.bd/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Show / hide TDS Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}
